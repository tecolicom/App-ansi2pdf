{
  "name": "ansi2pdf",
  "version": "0.1.1",
  "description": "Render terminal output with ANSI sequences to PDF",
  "license": "MIT",
  "author": "Kazumasa Utashiro",
  "homepage": "https://github.com/tecolicom/App-ansi2pdf#readme",
  "repository": {
    "type": "git",
